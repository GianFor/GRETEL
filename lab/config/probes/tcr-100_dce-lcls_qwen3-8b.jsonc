// Pilot, first pass: Tree-Cycles (100 graphs of 64 nodes, seeded generator so the
// cached splits always match the graphs, ~10 in test per fold), DCE seed
// counterfactual minimized by LocalSearch, narratives by Qwen3-8B under vllm.
// Writes lab/output/results/probes-pilot/.../cf_per_instance/fold_0/cf_<id>.json
// with the typed delta (seed and minimized) and the direct/inverse narratives.
// Second pass: scripts/run_probes.py --config lab/config/probes/judge_gpt-oss-20b.jsonc
{
    "experiment": {
        "scope": "probes-pilot",
        "parameters": {
            "lock_release_tout": 120,
            "propagate": [
                {"in_sections": ["doe-triplets/explainer"], "params": {"fold_id": 0}},
                {"in_sections": ["doe-triplets/oracle"], "params": {"fold_id": -1, "retrain": false}},
                {"in_sections": ["doe-triplets/dataset"], "params": {"compose_man": "lab/config/snippets/datasets/empty.json"}}
            ]
        }
    },
    "doe-triplets": [
        {
            "dataset": {
                "class": "src.dataset.dataset_base.Dataset",
                "parameters": {
                    "generator": {
                        "class": "src.dataset.generators.treecycles_seeded.TreeCyclesSeeded",
                        "parameters": {"num_instances": 100, "num_nodes_per_instance": 64, "ratio_nodes_in_cycles": 0.40, "seed": 0}
                    }
                }
            },
            "oracle": {
                "class": "src.oracle.custom.oracle_tree_cycles.TreeCyclesOracle",
                "parameters": {}
            },
            "compose_dataset_info": "./lab/config/snippets/dataset_infos/tcr-ablation-cycles.json",
            "explainer": {
                "class": "src.explainer.future.meta.generate_minimize.GenerateMinimize",
                "parameters": {
                    "fold_id": 0,
                    "generator": {
                        "class": "src.explainer.future.search.dces.DCESExplainer",
                        "parameters": {"epochs": 500}
                    },
                    "minimizer": {
                        "class": "src.explainer.future.metaheuristic.local_search.local_search.LocalSearch",
                        "parameters": {"neigh_factor": 4, "runtime_factor": 4, "max_runtime": 20, "max_neigh": 20, "seed": 0}
                    }
                }
            },
            "llm": {
                "class": "src.LLMexplaneability.huggingface.HuggingFaceLLM",
                "parameters": {
                    "model": "Qwen/Qwen3-8B",
                    "engine": "vllm",
                    "temperature": 0.0,
                    "seed": 0,
                    "max_new_tokens": 1024,
                    "enable_thinking": false,
                    "gpu_memory_utilization": 0.3,
                    "max_model_len": 8192
                }
            }
        }
    ],
    "evaluator": {
        "class": "src.evaluation.future.evaluator.Evaluator",
        "parameters": {"compose_pip": "./lab/config/snippets/generation_pipeline.json"}
    },
    "compose_strs": "./lab/config/snippets/default_store_paths.json"
}
